# ============================================================
# PhysioPS × HumanOS ANS Reporting AI — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit secrets to git.
# ============================================================

# ── Perplexity Sonar AI (existing) ─────────────────────────
PPLX_API_KEY=your_perplexity_api_key_here

# ── ElevenLabs TTS (server-only — never expose to client) ──
# Powers "Read aloud" + spoken answers in Ask Atom via /api/tts. If the API key
# is unset, the client falls back to the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice used for the Atom reply. Optional — defaults to the pinned Atom voice
# (gs0tAILXbY5DNrJrsM6F) when unset. The voice id is not a secret; the API key
# is, and it never leaves the server. The client can never choose the voice.
ELEVENLABS_VOICE_ID=gs0tAILXbY5DNrJrsM6F

# ── Akamai Managed PostgreSQL — Knowledge/RAG backend (server-only) ──
# Dedicated instance (humanos-ans-rag-pg) that backs the admin knowledge/RAG
# library (sources, chunks, versions, audit). Both values are SENSITIVE and must
# never be exposed to the client (no VITE_ prefix) or logged.
#
# HUMANOS_DATABASE_URL: the postgres:// connection string (includes credentials).
#   Paste WITHOUT a trailing newline. The app trims stray whitespace defensively.
HUMANOS_DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# HUMANOS_DATABASE_CA_CERT: the PEM CA certificate used to verify TLS
#   (rejectUnauthorized:true). When pasting as a single-line Vercel value, PEM
#   newlines may be encoded as literal "\n" — the app restores them on read.
HUMANOS_DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
# Optional: per-instance connection pool size (default 3, capped 10). Keep small
# for serverless.
# HUMANOS_DATABASE_POOL_MAX=3
#
# One-time setup against this backend (run from a trusted shell, not CI logs):
#   npm run db:migrate:rag   # create schema (idempotent; advisory-locked txn)
#   npm run db:seed:rag      # load curated NON-PII Colombo/ANS sources (optional)

# ── Supabase (server-only — never expose to client) ────────
# Still used for admin auth fallback + knowledge file Storage (binary uploads)
# and the (gated) production evidence-retrieval read path. The knowledge/RAG
# inventory itself now lives in Akamai PostgreSQL above.
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (client / Vite — safe to expose) ──────────────
# Same URL, but use the anon key (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin perimeter gateway (server-only) ──────────────────
# Optional env-configured username + password-hash login that sits IN FRONT of
# the Supabase magic-link auth + RLS (defense in depth). RLS remains the
# authoritative per-user authorization layer — the gateway never replaces it.
#
# The gateway is OPT-IN: it is only enforced when ALL THREE of the variables
# below are set. Leave them unset to keep the existing magic-link-only behaviour.
#
# NEVER put the plaintext password anywhere. Generate the scrypt hash locally:
#   node hash-admin-password.mjs        # prompts for the password
# then paste the printed value into ADMIN_GATEWAY_PASSWORD_HASH.
# Full activation guide: docs/ADMIN_GATEWAY_SETUP.md
ADMIN_GATEWAY_USERNAME=admin
# Format: scrypt$<N>$<r>$<p>$<saltBase64>$<hashBase64> (output of the script above)
ADMIN_GATEWAY_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>
# High-entropy random string used to sign the session cookie (e.g. `openssl rand -base64 48`).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Admin gateway tuning (all optional, sensible defaults) ──
# Session cookie lifetime in seconds (default 28800 = 8h).
ADMIN_SESSION_TTL_SEC=28800
# Failed-attempt lockout: max attempts per window before lockout (default 5).
ADMIN_GATEWAY_MAX_ATTEMPTS=5
# Sliding window for counting failed attempts, seconds (default 900 = 15m).
ADMIN_GATEWAY_WINDOW_SEC=900
# Lockout duration once the threshold is hit, seconds (default 900 = 15m).
ADMIN_GATEWAY_LOCKOUT_SEC=900

# ── Notes ──────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS. Server-only. Never put in VITE_ variables.
# VITE_SUPABASE_ANON_KEY: subject to RLS. Safe for client. Uses the magic-link auth session.
# ADMIN_GATEWAY_* / ADMIN_SESSION_*: server-only. Never expose as VITE_ variables.
