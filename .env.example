# ============================================================
# PhysioPS × HumanOS ANS Reporting AI — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit secrets to git.
# ============================================================

# ── Perplexity Sonar AI (existing) ─────────────────────────
PPLX_API_KEY=your_perplexity_api_key_here
# Knowledge-RAG embeddings (server-only; same Perplexity credential as above).
# Optional overrides — EMBEDDING_DIMENSIONS must match the DB vector(N) column
# and every stored vector, so only change these with a migration. Names only:
# never commit real values.
EMBEDDING_MODEL=pplx-embed-v1-0.6b
EMBEDDING_DIMENSIONS=1024

# ── ElevenLabs TTS (server-only — never expose to client) ──
# Powers "Read aloud" in Ask Atom via /api/tts. If unset, the client
# falls back to the browser's built-in speech synthesis.
# The Atom voice ID is pinned server-side in api/tts.ts (gs0tAILXbY5DNrJrsM6F).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Supabase (server-only — never expose to client) ────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (client / Vite — safe to expose) ──────────────
# Same URL, but use the anon key (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin console sign-in (server-only) ────────────────────
# The admin console (/#/admin/knowledge and all /admin routes) is protected by a
# username/password sign-in that mints a signed, HttpOnly, Secure,
# SameSite=Strict session cookie. It REPLACES the former Supabase magic-link
# email login. Admin access is enforced only when ALL THREE variables below are
# set (fail-closed: if unset, the console is locked).
#
# NEVER commit real credential VALUES. Configure these as protected Vercel
# environment variables (Production/Preview). Names only are documented here.
#
# ADMIN_USERNAME        — the admin login username.
# ADMIN_PASSWORD        — the admin login password (compared in constant time;
#                         never stored in the client, never logged).
# ADMIN_SESSION_SECRET  — high-entropy random string used to HMAC-sign the
#                         session cookie, e.g. `openssl rand -base64 48`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Admin sign-in tuning (all optional, sensible defaults) ──
# Session cookie lifetime in seconds (default 28800 = 8h; clamped 1h–12h).
ADMIN_SESSION_TTL_SEC=28800
# Per-instance failed-attempt lockout: max attempts per window (default 5).
ADMIN_GATEWAY_MAX_ATTEMPTS=5
# Sliding window for counting failed attempts, seconds (default 900 = 15m).
ADMIN_GATEWAY_WINDOW_SEC=900
# Lockout duration once the threshold is hit, seconds (default 900 = 15m).
ADMIN_GATEWAY_LOCKOUT_SEC=900

# ── Notes ──────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS. Server-only. Never put in VITE_ variables.
#   Still required — the admin data/RAG layer reads/writes via the service-role
#   client after the cookie authorizes the request.
# ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_SESSION_SECRET: server-only. NEVER
#   expose as VITE_ variables and never hardcode in client code or the repo.
