# ============================================================
# PhysioPS × HumanOS ANS Reporting AI — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit secrets to git.
# ============================================================

# ── Perplexity Sonar AI (existing) ─────────────────────────
PPLX_API_KEY=your_perplexity_api_key_here

# ── ElevenLabs TTS (server-only — never expose to client) ──
# Powers "Read aloud" in Ask Atom via /api/tts. If unset, the client
# falls back to the browser's built-in speech synthesis.
# The Atom voice ID is pinned server-side in api/tts.ts (gs0tAILXbY5DNrJrsM6F).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Supabase (server-only — never expose to client) ────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (client / Vite — safe to expose) ──────────────
# Same URL, but use the anon key (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin perimeter gateway (server-only) ──────────────────
# Optional env-configured username + password-hash login that sits IN FRONT of
# the Supabase magic-link auth + RLS (defense in depth). RLS remains the
# authoritative per-user authorization layer — the gateway never replaces it.
#
# The gateway is OPT-IN: it is only enforced when ALL THREE of the variables
# below are set. Leave them unset to keep the existing magic-link-only behaviour.
#
# NEVER put the plaintext password anywhere. Generate the scrypt hash locally:
#   node scripts/hash-admin-password.mjs        # prompts for the password
# then paste the printed value into ADMIN_GATEWAY_PASSWORD_HASH.
ADMIN_GATEWAY_USERNAME=admin
# Format: scrypt$<N>$<r>$<p>$<saltBase64>$<hashBase64> (output of the script above)
ADMIN_GATEWAY_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>
# High-entropy random string used to sign the session cookie (e.g. `openssl rand -base64 48`).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Admin gateway tuning (all optional, sensible defaults) ──
# Session cookie lifetime in seconds (default 28800 = 8h).
ADMIN_SESSION_TTL_SEC=28800
# Failed-attempt lockout: max attempts per window before lockout (default 5).
ADMIN_GATEWAY_MAX_ATTEMPTS=5
# Sliding window for counting failed attempts, seconds (default 900 = 15m).
ADMIN_GATEWAY_WINDOW_SEC=900
# Lockout duration once the threshold is hit, seconds (default 900 = 15m).
ADMIN_GATEWAY_LOCKOUT_SEC=900

# ── Notes ──────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS. Server-only. Never put in VITE_ variables.
# VITE_SUPABASE_ANON_KEY: subject to RLS. Safe for client. Uses the magic-link auth session.
# ADMIN_GATEWAY_* / ADMIN_SESSION_*: server-only. Never expose as VITE_ variables.
