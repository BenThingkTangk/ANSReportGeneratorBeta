# ============================================================
# PhysioPS × HumanOS ANS Reporting AI — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit secrets to git.
# ============================================================

# ── Perplexity Sonar AI (existing) ─────────────────────────
PPLX_API_KEY=your_perplexity_api_key_here

# ── Supabase (server-only — never expose to client) ────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (client / Vite — safe to expose) ──────────────
# Same URL, but use the anon key (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Notes ──────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS. Server-only. Never put in VITE_ variables.
# VITE_SUPABASE_ANON_KEY: subject to RLS. Safe for client. Uses the magic-link auth session.
